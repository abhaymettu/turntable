<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Turntable</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- First run never asks for an address. The app browses _turntable._tcp to find the
	     server it is about to redeem a pairing code against, which is what iOS gates behind
	     the local network prompt. Declining it means the app cannot find the server, so the
	     pairing screen says to turn it back on in Settings. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Turntable looks for your server on this Wi-Fi so pairing only asks you for a code.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_turntable._tcp</string>
	</array>
	<key>NSAppleMusicUsageDescription</key>
	<string>Turntable searches Apple Music and plays what you or your agent queue.</string>
	<!-- The server you pair with is usually plain http on an address you own: a LAN IP,
	     a private VPN address, a machine on your desk. NSAllowsLocalNetworking covers only
	     localhost and .local, so reaching any of those over http needs this. Point the app
	     at an https address and none of this applies. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
</dict>
</plist>
